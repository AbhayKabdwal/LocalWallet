<?xml version="1.0" encoding="utf-8"?>
<!--
     LocalWallet launcher icon.

     Adaptive-icon foreground on the standard 108dp canvas. Artwork is kept
     inside the central ~66dp safe circle so no launcher mask clips it, and the
     shapes are chunky enough to still read at notification size.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Card tucked into the wallet, narrower than the body so it reads as a card -->
    <path
        android:fillColor="#C9BEFF"
        android:pathData="M42,33 L68,33 A5,5 0 0 1 73,38 L73,48 L37,48 L37,38 A5,5 0 0 1 42,33 Z" />

    <!-- Wallet body -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M37,43 L71,43 A9,9 0 0 1 80,52 L80,67 A9,9 0 0 1 71,76 L37,76 A9,9 0 0 1 28,67 L28,52 A9,9 0 0 1 37,43 Z" />

    <!-- Clasp pocket on the right edge -->
    <path
        android:fillColor="#C9BEFF"
        android:pathData="M64,53 L80,53 L80,66 L64,66 A6.5,6.5 0 0 1 64,53 Z" />

    <!-- Clasp stud -->
    <path
        android:fillColor="#6B4DFF"
        android:pathData="M70.5,56 A3.6,3.6 0 1 1 70.5,63.2 A3.6,3.6 0 1 1 70.5,56 Z" />
</vector>
