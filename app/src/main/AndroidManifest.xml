<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
         Read-only access to the SMS inbox for the optional "import from messages"
         feature. Parsing happens entirely on-device and the app declares no
         INTERNET permission, so nothing can be uploaded. The feature is off by
         default and the permission is only requested if the user turns it on.
    -->
    <!--
        Optional. Only needed to read bank messages already on the phone;
        day-to-day capture runs through notification access instead, so the
        app works fully without ever granting this.
    -->
    <uses-permission android:name="android.permission.READ_SMS" />

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
         This app makes no network requests, so it declares no INTERNET permission.
         WorkManager and friends merge ACCESS_NETWORK_STATE in for their own
         network constraints, which nothing here uses - strip it so the installed
         APK really does ask for no network access at all.
    -->
    <uses-permission
        android:name="android.permission.ACCESS_NETWORK_STATE"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.INTERNET"
        tools:node="remove" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28"
        android:requestLegacyExternalStorage="true" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name=".IvyAndroidApp"
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:requestLegacyExternalStorage="true"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="false"
        android:theme="@style/AppTheme"
        tools:ignore="LockedOrientationActivity">

        <activity
            android:name=".RootActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize|stateAlwaysHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="ivy.wallet.intent.action.add_transaction" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>
        <!-- It fixes HiltWorker injection for newer WorkManager versions -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            tools:node="remove" />

        <receiver
            android:name="com.ivy.widget.transaction.AddTransactionWidget"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/add_transaction_widget_info" />
        </receiver>

        <receiver
            android:name="com.ivy.widget.transaction.AddTransactionWidgetCompact"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/add_transaction_widget_compact_info" />
        </receiver>

        <receiver
            android:name="com.ivy.widget.balance.WalletBalanceWidgetReceiver"
            android:enabled="@bool/glance_appwidget_available"
            android:exported="true"
            android:label="@string/wallet_balance"
            tools:ignore="instantiatable">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/wallet_balance_widget_info" />
        </receiver>

        <receiver
            android:name="com.ivy.widget.messagesync.MessageSyncWidgetReceiver"
            android:enabled="@bool/glance_appwidget_available"
            android:exported="true"
            android:label="@string/message_sync_widget"
            tools:ignore="instantiatable">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/message_sync_widget_info" />
        </receiver>

        <!--
            Reads bank alerts without READ_SMS. BIND_NOTIFICATION_LISTENER_SERVICE
            is held by the system against this service, not requested by the app,
            so it adds nothing to the app's permission list; the user grants it
            once in Settings > Notification access.
        -->
        <service
            android:name="com.ivy.smsimport.notifications.BankNotificationListener"
            android:exported="true"
            android:label="@string/read_bank_notifications"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <service
            android:name=".PaymentTileService"
            android:exported="true"
            android:icon="@drawable/ic_launcher_foreground"
            android:label="Add Payment"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>

</manifest>
